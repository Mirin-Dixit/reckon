{
  "JobSummary": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "ragbench.experiment-job.v1",
        "title": "Schema Version",
        "type": "string"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "status": {
        "enum": [
          "queued",
          "running",
          "done",
          "partial",
          "failed"
        ],
        "title": "Status",
        "type": "string"
      },
      "created_at": {
        "title": "Created At",
        "type": "string"
      },
      "updated_at": {
        "title": "Updated At",
        "type": "string"
      },
      "notice": {
        "const": "Synthetic fixture \u2014 development only; no empirical claims.",
        "title": "Notice",
        "type": "string"
      },
      "empirical_evaluation": {
        "const": false,
        "title": "Empirical Evaluation",
        "type": "boolean"
      },
      "configuration": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Configuration",
        "type": "object"
      },
      "dataset_fingerprint": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Dataset Fingerprint",
        "type": "object"
      },
      "runtime_source_sha256": {
        "title": "Runtime Source Sha256",
        "type": "string"
      },
      "expected_run_count": {
        "maximum": 40,
        "minimum": 1,
        "title": "Expected Run Count",
        "type": "integer"
      },
      "observed_run_count": {
        "maximum": 40,
        "minimum": 0,
        "title": "Observed Run Count",
        "type": "integer"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Error"
      }
    },
    "required": [
      "schema_version",
      "id",
      "status",
      "created_at",
      "updated_at",
      "notice",
      "empirical_evaluation",
      "configuration",
      "dataset_fingerprint",
      "runtime_source_sha256",
      "expected_run_count",
      "observed_run_count",
      "error"
    ],
    "title": "JobSummary",
    "type": "object"
  },
