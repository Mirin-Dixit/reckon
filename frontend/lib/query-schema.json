{
  "request": {
    "$defs": {
      "GenerationRequest": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "temperature": {
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temperature"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "maximum": 32768,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Output Tokens"
          },
          "timeout_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 120,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout Seconds"
          }
        },
        "title": "GenerationRequest",
        "type": "object"
      },
      "PolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "always_answer",
              "prompt_abstention",
              "threshold"
            ],
            "title": "Name",
            "type": "string"
          },
          "score_type": {
            "anyOf": [
              {
                "enum": [
                  "bm25",
                  "dense_cosine",
                  "hybrid_rrf"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score Type"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Threshold"
          },
          "direction": {
            "default": "at_least",
            "enum": [
              "at_least",
              "at_most"
            ],
            "title": "Direction",
            "type": "string"
          },
          "missing_score_decision": {
            "default": "ABSTAIN",
            "enum": [
              "ABSTAIN",
              "ANSWER"
            ],
            "title": "Missing Score Decision",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "PolicyRequest",
        "type": "object"
      },
      "RetrievalRequest": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "default": "bm25",
            "enum": [
              "bm25",
              "dense",
              "hybrid"
            ],
            "title": "Method",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 20,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          },
          "candidate_k": {
            "anyOf": [
              {
                "maximum": 256,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Candidate K"
          },
          "rrf_k": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rrf K"
          }
        },
        "title": "RetrievalRequest",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "question": {
        "maxLength": 8000,
        "minLength": 1,
        "title": "Question",
        "type": "string"
      },
      "retrieval": {
        "$ref": "#/$defs/RetrievalRequest"
      },
      "policy": {
        "$ref": "#/$defs/PolicyRequest"
      },
      "generation": {
        "$ref": "#/$defs/GenerationRequest"
      },
      "experiment_id": {
        "anyOf": [
          {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Experiment Id"
      },
      "run_id": {
        "anyOf": [
          {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Run Id"
      }
    },
    "required": [
      "question",
      "policy"
    ],
    "title": "QueryRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "AssessmentResponse": {
        "additionalProperties": false,
        "properties": {
          "relevance": {
            "$ref": "#/$defs/Relevance"
          },
          "sufficiency": {
            "$ref": "#/$defs/Sufficiency"
          },
          "supporting_evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Supporting Evidence Ids",
            "type": "array"
          },
          "contradictions": {
            "items": {
              "type": "string"
            },
            "title": "Contradictions",
            "type": "array"
          },
          "missing_premises": {
            "items": {
              "type": "string"
            },
            "title": "Missing Premises",
            "type": "array"
          },
          "unsupported_assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Unsupported Assumptions",
            "type": "array"
          },
          "ambiguity_requiring_clarification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ambiguity Requiring Clarification"
          }
        },
        "required": [
          "relevance",
          "sufficiency",
          "supporting_evidence_ids",
          "contradictions",
          "missing_premises",
          "unsupported_assumptions",
          "ambiguity_requiring_clarification"
        ],
        "title": "AssessmentResponse",
        "type": "object"
      },
      "CitationResponse": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "title": "Claim",
            "type": "string"
          },
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "start_char": {
            "title": "Start Char",
            "type": "integer"
          },
          "end_char": {
            "title": "End Char",
            "type": "integer"
          }
        },
        "required": [
          "claim",
          "evidence_id",
          "quote",
          "start_char",
          "end_char"
        ],
        "title": "CitationResponse",
        "type": "object"
      },
      "Decision": {
        "description": "The three user-facing outcomes supported by the RAG system.",
        "enum": [
          "ANSWER",
          "ABSTAIN",
          "CLARIFY"
        ],
        "title": "Decision",
        "type": "string"
      },
      "EvidenceResponse": {
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "start_char": {
            "title": "Start Char",
            "type": "integer"
          },
          "end_char": {
            "title": "End Char",
            "type": "integer"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Url"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          },
          "source_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Date"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Domain"
          },
          "retrieval_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retrieval Rank"
          },
          "retrieval_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retrieval Score"
          },
          "retrieval_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Retrieval Method"
          },
          "contains_injection": {
            "default": false,
            "title": "Contains Injection",
            "type": "boolean"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/$defs/ScoreResponse"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "text",
          "start_char",
          "end_char"
        ],
        "title": "EvidenceResponse",
        "type": "object"
      },
      "ExecutionStatus": {
        "description": "Execution outcome, distinct from an intentional ABSTAIN decision.",
        "enum": [
          "succeeded",
          "failed",
          "timed_out",
          "refused",
          "incomplete"
        ],
        "title": "ExecutionStatus",
        "type": "string"
      },
      "JsonValue": {},
      "PolicyParameters": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Provider"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/$defs/SettingsResponse"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "score_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score Type"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Threshold"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Direction"
          },
          "aggregation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Aggregation"
          },
          "observed_aggregate_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Observed Aggregate Score"
          },
          "missing_score_decision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Missing Score Decision"
          }
        },
        "title": "PolicyParameters",
        "type": "object"
      },
      "ProviderResponse": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "api_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api Version"
          },
          "model_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Digest"
          },
          "quantization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quantization"
          },
          "completion_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Completion Reason"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "ProviderResponse",
        "type": "object"
      },
      "ReasonCode": {
        "description": "Machine-readable explanations for abstention and clarification outcomes.",
        "enum": [
          "insufficient_evidence",
          "conflicting_evidence",
          "unsupported_premise",
          "ambiguous_intent",
          "out_of_scope",
          "other"
        ],
        "title": "ReasonCode",
        "type": "string"
      },
      "ReasonResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/ReasonCode"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "code",
          "explanation"
        ],
        "title": "ReasonResponse",
        "type": "object"
      },
      "Relevance": {
        "description": "How closely retrieved evidence relates to the request.",
        "enum": [
          "relevant",
          "partially_relevant",
          "irrelevant",
          "not_assessed"
        ],
        "title": "Relevance",
        "type": "string"
      },
      "ScoreKind": {
        "enum": [
          "bm25",
          "dense_cosine",
          "hybrid_rrf",
          "prompt_self_assessment"
        ],
        "title": "ScoreKind",
        "type": "string"
      },
      "ScoreResponse": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/$defs/ScoreKind"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "source": {
            "$ref": "#/$defs/ScoreSource"
          },
          "retrieval_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Method"
          },
          "parameters": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Parameters",
            "type": "object"
          },
          "role": {
            "$ref": "#/$defs/ScoreRole"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          },
          "threshold_direction": {
            "anyOf": [
              {
                "enum": [
                  "at_least",
                  "at_most"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Direction"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Availability",
            "type": "string"
          },
          "lower_bound": {
            "title": "Lower Bound",
            "type": "number"
          },
          "upper_bound": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Bound"
          },
          "direction": {
            "enum": [
              "higher_is_more_support",
              "higher_is_more_relevant"
            ],
            "title": "Direction",
            "type": "string"
          },
          "calibration": {
            "const": "uncalibrated",
            "title": "Calibration",
            "type": "string"
          },
          "schema_version": {
            "const": "ragbench.score.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value",
          "source",
          "retrieval_method",
          "parameters",
          "role",
          "threshold",
          "threshold_direction",
          "unavailable_reason",
          "availability",
          "lower_bound",
          "upper_bound",
          "direction",
          "calibration",
          "schema_version"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "ScoreRole": {
        "enum": [
          "observational",
          "threshold_input",
          "self_assessment"
        ],
        "title": "ScoreRole",
        "type": "string"
      },
      "ScoreSource": {
        "enum": [
          "retrieval",
          "model_self_report"
        ],
        "title": "ScoreSource",
        "type": "string"
      },
      "SettingsResponse": {
        "additionalProperties": false,
        "properties": {
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          },
          "timeout_seconds": {
            "title": "Timeout Seconds",
            "type": "number"
          }
        },
        "required": [
          "temperature",
          "seed",
          "max_output_tokens",
          "timeout_seconds"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "Sufficiency": {
        "description": "Whether the evidence establishes the facts needed to respond.",
        "enum": [
          "sufficient",
          "partial",
          "insufficient",
          "contradictory",
          "not_assessed"
        ],
        "title": "Sufficiency",
        "type": "string"
      },
      "UsageResponse": {
        "additionalProperties": false,
        "properties": {
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "total_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Tokens"
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "title": "UsageResponse",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "experiment_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Experiment Id"
      },
      "run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Run Id"
      },
      "decision": {
        "$ref": "#/$defs/Decision"
      },
      "answer": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Answer"
      },
      "clarification_question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Clarification Question"
      },
      "decision_reason": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReasonResponse"
          },
          {
            "type": "null"
          }
        ]
      },
      "citations": {
        "items": {
          "$ref": "#/$defs/CitationResponse"
        },
        "title": "Citations",
        "type": "array"
      },
      "retrieved_evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceResponse"
        },
        "title": "Retrieved Evidence",
        "type": "array"
      },
      "evidence_assessment": {
        "$ref": "#/$defs/AssessmentResponse"
      },
      "policy_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Policy Name"
      },
      "policy_parameters": {
        "$ref": "#/$defs/PolicyParameters"
      },
      "provider": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProviderResponse"
          },
          {
            "type": "null"
          }
        ]
      },
      "execution_status": {
        "$ref": "#/$defs/ExecutionStatus"
      },
      "unsupported_premises": {
        "items": {
          "type": "string"
        },
        "title": "Unsupported Premises",
        "type": "array"
      },
      "surfaced_contradictions": {
        "items": {
          "type": "string"
        },
        "title": "Surfaced Contradictions",
        "type": "array"
      },
      "prompt_version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Prompt Version"
      },
      "latency_ms": {
        "anyOf": [
