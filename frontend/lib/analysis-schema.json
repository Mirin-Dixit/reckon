{
  "$defs": {
    "Area": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ragbench.risk-coverage.v1",
          "default": "ragbench.risk-coverage.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "axis": {
          "const": "end_to_end_coverage",
          "default": "end_to_end_coverage",
          "title": "Axis",
          "type": "string"
        },
        "rule": {
          "const": "right_step",
          "default": "right_step",
          "title": "Rule",
          "type": "string"
        },
        "full_aurc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Aurc"
        },
        "partial_aurc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Aurc"
        },
        "coverage_bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Bounds"
        },
        "undefined_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undefined Reason"
        }
      },
      "title": "Area",
      "type": "object"
    },
    "CurveComparison": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "string"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "difference": {
          "const": "left_minus_right",
          "default": "left_minus_right",
          "title": "Difference",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/Interval"
        }
      },
      "required": [
        "left",
        "right",
        "uncertainty"
      ],
      "title": "CurveComparison",
      "type": "object"
    },
    "CurvePoint": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "coverage": {
          "title": "Coverage",
          "type": "number"
        },
        "risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        }
      },
      "required": [
        "row_id",
        "coverage",
        "risk"
      ],
      "title": "CurvePoint",
      "type": "object"
    },
    "CurveSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "title": "Points",
          "type": "array"
        },
        "area": {
          "$ref": "#/$defs/Area"
        },
        "uncertainty": {
          "$ref": "#/$defs/Interval"
        }
      },
      "required": [
        "id",
        "points",
        "area",
        "uncertainty"
      ],
      "title": "CurveSummary",
      "type": "object"
    },
    "Fraction": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ],
      "title": "Fraction",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "valid_replicates": {
          "title": "Valid Replicates",
          "type": "integer"
        },
        "undefined_replicates": {
          "title": "Undefined Replicates",
          "type": "integer"
        },
        "degenerate": {
          "title": "Degenerate",
          "type": "boolean"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "estimate",
        "lower",
        "upper",
        "valid_replicates",
        "undefined_replicates",
        "degenerate",
        "unavailable_reason"
      ],
      "title": "Interval",
      "type": "object"
    },
    "PointComparison": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "title": "Left",
          "type": "string"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "difference": {
          "const": "left_minus_right",
          "default": "left_minus_right",
          "title": "Difference",
          "type": "string"
        },
        "uncertainty": {
          "additionalProperties": {
            "$ref": "#/$defs/Interval"
          },
          "propertyNames": {
            "enum": [
              "end_to_end_coverage",
              "successful_execution_coverage",
              "selective_risk",
              "failure_rate"
            ]
          },
          "title": "Uncertainty",
          "type": "object"
        },
        "risk_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk Unavailable Reason"
        }
      },
      "required": [
        "left",
        "right",
        "uncertainty",
        "risk_unavailable_reason"
      ],
      "title": "PointComparison",
      "type": "object"
    },
    "PointSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "policy": {
          "enum": [
            "always_answer",
            "threshold",
            "prompt_abstention"
          ],
          "title": "Policy",
          "type": "string"
        },
        "experiment_id": {
          "title": "Experiment Id",
          "type": "string"
        },
        "source_record_sha256": {
          "title": "Source Record Sha256",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "at_least",
                "at_most"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "end_to_end_coverage": {
          "$ref": "#/$defs/Fraction"
        },
        "successful_execution_coverage": {
          "$ref": "#/$defs/Fraction"
        },
        "failure_rate": {
          "$ref": "#/$defs/Fraction"
        },
        "missing_rate": {
          "$ref": "#/$defs/Fraction"
        },
        "judgment_completeness": {
          "$ref": "#/$defs/Fraction"
        },
        "selective_risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selective Risk"
        },
        "risk_bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk Bounds"
        },
        "undefined_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Undefined Reason"
        },
        "uncertainty": {
          "additionalProperties": {
            "$ref": "#/$defs/Interval"
          },
          "propertyNames": {
            "enum": [
              "end_to_end_coverage",
              "successful_execution_coverage",
              "selective_risk",
              "failure_rate"
            ]
          },
          "title": "Uncertainty",
          "type": "object"
        }
      },
      "required": [
        "id",
        "policy",
        "experiment_id",
        "source_record_sha256",
        "threshold",
        "direction",
        "end_to_end_coverage",
        "successful_execution_coverage",
        "failure_rate",
        "missing_rate",
        "judgment_completeness",
        "selective_risk",
        "risk_bounds",
        "undefined_reason",
        "uncertainty"
      ],
      "title": "PointSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ragbench.matched-analysis.v1",
      "default": "ragbench.matched-analysis.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "empirical_evaluation": {
      "const": false,
      "default": false,
      "title": "Empirical Evaluation",
      "type": "boolean"
    },
    "notice": {
      "const": "Synthetic development only; lexical proxy is not semantic correctness.",
      "default": "Synthetic development only; lexical proxy is not semantic correctness.",
      "title": "Notice",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev"
      ],
      "title": "Split",
      "type": "string"
    },
    "retrieval_method": {
      "enum": [
        "bm25",
        "dense",
        "hybrid"
      ],
      "title": "Retrieval Method",
      "type": "string"
    },
    "provenance_sha256": {
      "title": "Provenance Sha256",
      "type": "string"
    },
    "question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Question Ids",
      "type": "array"
    },
    "matched_questions": {
      "title": "Matched Questions",
      "type": "integer"
    },
    "resampling_units": {
      "title": "Resampling Units",
      "type": "integer"
    },
    "cluster_sizes": {
      "items": {
        "type": "integer"
      },
      "title": "Cluster Sizes",
      "type": "array"
    },
    "grouping": {
      "enum": [
        "question",
        "declared_question_family"
      ],
      "title": "Grouping",
      "type": "string"
    },
    "family_map_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Family Map Sha256"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "resamples": {
      "title": "Resamples",
      "type": "integer"
    },
    "interval_method": {
      "const": "paired_percentile_95",
      "default": "paired_percentile_95",
      "title": "Interval Method",
      "type": "string"
    },
    "loss_basis": {
      "enum": [
        "unknown",
        "synthetic_lexical_proxy"
      ],
      "title": "Loss Basis",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/PointSummary"
      },
      "title": "Rows",
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/PointComparison"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "curves": {
      "items": {
        "$ref": "#/$defs/CurveSummary"
      },
      "title": "Curves",
      "type": "array"
    },
    "curve_comparisons": {
      "items": {
        "$ref": "#/$defs/CurveComparison"
      },
      "title": "Curve Comparisons",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "split",
    "retrieval_method",
    "provenance_sha256",
    "question_ids",
    "matched_questions",
    "resampling_units",
    "cluster_sizes",
    "grouping",
    "family_map_sha256",
    "seed",
    "resamples",
    "loss_basis",
    "rows",
    "comparisons",
    "curves",
    "curve_comparisons",
    "limitations"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
