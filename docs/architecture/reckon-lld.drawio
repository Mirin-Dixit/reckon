        <mxCell id="lld_title" value="&lt;b style=&quot;font-size:22px;color:#0f172a;&quot;&gt;RECKON &amp;#8212; Low-Level Design (LLD): Query Execution &amp;amp; Decision Logic&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;Deterministic Query Flow &amp;#8226; Pre-Check Short-Circuiting &amp;#8226; Grounded Citation Verification &amp;#8226; Distinct Batch Experiment Branch&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1050" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lld_badge" value="&lt;b style=&quot;color:#166534;font-size:12px;&quot;&gt;VERIFIED LOCAL PIPELINE CONTRACTS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#334155;font-size:11px;&quot;&gt;Pre-Check Compute Savings &amp;#8226; Exact Offset Substring Slicing &amp;#8226; Explicit Failure Codes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;align=center;" vertex="1" parent="1">
