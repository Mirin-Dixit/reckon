        <mxCell id="zone1_container" value="&lt;b style=&quot;font-size:14px;color:#0369a1;&quot;&gt;MAIN INTERACTIVE QUERY FLOW (POST /api/v1/query &amp;rarr; Query Lab)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Synchronous interactive query lifecycle &amp;#8226; Ephemeral response &amp;#8226; Never persists to SQLite or updates dashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="35" y="85" width="1215" height="700" as="geometry" />
        </mxCell>
    

        <mxCell id="s1_box" value="&lt;b style=&quot;font-size:13px;color:#0369a1;&quot;&gt;STAGE 1: REQUEST VALIDATION&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#64748b;&quot;&gt;app.api.routes.query&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #bae6fd;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#0f172a;line-height:1.45;&quot;&gt;&lt;b&gt;POST /api/v1/query&lt;/b&gt;&lt;br/&gt;&amp;#8226; Body: &lt;b&gt;QueryRequest&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;- question: str&lt;br/&gt;&amp;nbsp;&amp;nbsp;- retrieval: {&quot;method&quot;, &quot;top_k&quot;}&lt;br/&gt;&amp;nbsp;&amp;nbsp;- policy: {&quot;name&quot;, &quot;threshold&quot;}&lt;br/&gt;&amp;nbsp;&amp;nbsp;- generation: {&quot;model&quot;, &quot;temperature&quot;}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Pydantic Schema Guard:&lt;/b&gt;&lt;br/&gt;&amp;#8226; extra=&quot;forbid&quot;&lt;br/&gt;&amp;#8226; Blocks gold label leakage&lt;br/&gt;&amp;#8226; Rejects invalid params &amp;rarr; HTTP 422&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="130" width="205" height="230" as="geometry" />
        </mxCell>
    

        <mxCell id="s2_box" value="&lt;b style=&quot;font-size:13px;color:#166534;&quot;&gt;STAGE 2: RETRIEVAL SUBSYSTEM&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#166534;&quot;&gt;app.retrieval.runtime &amp; app.retrieval.*&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #86efac;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#14532d;line-height:1.45;&quot;&gt;&lt;b&gt;Retrieval Dispatcher:&lt;/b&gt;&lt;br/&gt;&amp;#8226; &lt;b&gt;BM25Index:&lt;/b&gt; Okapi BM25 (k1=1.5, b=0.75)&lt;br/&gt;&amp;#8226; &lt;b&gt;DenseIndex:&lt;/b&gt; all-minilm:22m (384-dim BERT) cosine&lt;br/&gt;&amp;#8226; &lt;b&gt;HybridIndex:&lt;/b&gt; RRF Fusion (k=60)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Evidence Packaging:&lt;/b&gt;&lt;br/&gt;&amp;#8226; Slices top_k (default 5) chunks&lt;br/&gt;&amp;#8226; Offsets: [start_char, end_char]&lt;br/&gt;&amp;#8226; Aggregates: &lt;b&gt;max_score&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="225" height="230" as="geometry" />
        </mxCell>
    

        <mxCell id="s3_box" value="&lt;b style=&quot;font-size:13px;color:#78350f;&quot;&gt;STAGE 3: DECISION POLICY PRE-CHECK&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#92400e;&quot;&gt;app.generation.policies &amp; pipeline.py&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fde68a;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#451a03;line-height:1.45;&quot;&gt;&lt;b&gt;Evaluate Active Policy:&lt;/b&gt;&lt;br/&gt;&amp;#8226; &lt;b&gt;Threshold Policy:&lt;/b&gt; Evaluates max_score vs threshold&lt;br/&gt;&amp;#8226; &lt;b&gt;Prompt Abstention:&lt;/b&gt; Structured sufficiency judgment&lt;br/&gt;&amp;#8226; &lt;b&gt;Always Answer:&lt;/b&gt; Baseline policy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="675" y="130" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- Decision Diamond: max_score >= threshold? -->
        <mxCell id="s3_diamond" value="Score &amp;ge; Threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;fontSize=12;fontStyle=1;fontColor:#78350f;" vertex="1" parent="1">
          <mxGeometry x="705" y="275" width="175" height="65" as="geometry" />
        </mxCell>

        <!-- Outcome: Short-Circuit Abstention -->
        <mxCell id="s3_short_circuit" value="&lt;b style=&quot;font-size:13px;color:#b91c1c;&quot;&gt;SHORT-CIRCUIT ABSTAIN&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fecaca;margin:5px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#7f1d1d;line-height:1.4;&quot;&gt;&amp;#8226; &lt;b&gt;Decision:&lt;/b&gt; ABSTAIN&lt;br/&gt;&amp;#8226; &lt;b&gt;ReasonCode:&lt;/b&gt; INSUFFICIENT_EVIDENCE&lt;br/&gt;&amp;#8226; &lt;b&gt;Answer:&lt;/b&gt; null &amp;#8226; &lt;b&gt;Citations:&lt;/b&gt; []&lt;br/&gt;&amp;#8226; &lt;b&gt;Compute Saved:&lt;/b&gt; 100% (No LLM Call)&lt;br/&gt;&amp;#8226; Returns HTTP 200 QueryResponse&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="945" y="245" width="280" height="125" as="geometry" />
        </mxCell>
    

        <mxCell id="s4_box" value="&lt;b style=&quot;font-size:13px;color:#0e7490;&quot;&gt;STAGE 4: LLM ANSWER GENERATION&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#0e7490;&quot;&gt;app.generation.generator &amp; Ollama Relay&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #a5f3fc;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#164e63;line-height:1.45;&quot;&gt;&amp;#8226; Invokes Ollama &lt;b&gt;POST /api/chat&lt;/b&gt; via internal relay (:11434)&lt;br/&gt;&amp;#8226; Model receives retrieved chunks in &lt;b&gt;EvidenceContext&lt;/b&gt;&lt;br/&gt;&amp;#8226; Generates grounded response with structured citations:&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;ClaimCitation:&lt;/b&gt; [evidence_id, start_char, end_char, quote]&lt;br/&gt;&amp;#8226; Emits latency &amp;amp; token usage metrics&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#06b6d4;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="440" width="460" height="150" as="geometry" />
        </mxCell>
    

        <mxCell id="s5_box" value="&lt;b style=&quot;font-size:13px;color:#166534;&quot;&gt;STAGE 5: EXACT CITATION VERIFICATION GUARD&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#166534;&quot;&gt;app.generation.contracts::validate_citations&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #86efac;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#14532d;line-height:1.45;&quot;&gt;&lt;b&gt;Strict 3-Way Citation Verification Logic:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Chunk ID Integrity:&lt;/b&gt; citation.evidence_id exists in retrieved chunk set&lt;br/&gt;2. &lt;b&gt;Offset Bounds Check:&lt;/b&gt; 0 &amp;le; (end_char - chunk.start) &amp;le; len(chunk.text)&lt;br/&gt;3. &lt;b&gt;Byte-Exact Slice Equality:&lt;/b&gt; chunk.text[start:end] == citation.quote&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="565" y="440" width="450" height="150" as="geometry" />
        </mxCell>

        <!-- Citation Validation Diamond -->
        <mxCell id="s5_diamond" value="Citations Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;fontSize=12;fontStyle=1;fontColor:#166534;" vertex="1" parent="1">
          <mxGeometry x="705" y="630" width="170" height="65" as="geometry" />
        </mxCell>

        <!-- Outcome A: Verification Failure (HTTP 502) -->
        <mxCell id="s5_failure" value="&lt;b style=&quot;font-size:13px;color:#b91c1c;&quot;&gt;CITATION FAILURE (HTTP 502)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fecaca;margin:5px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#7f1d1d;line-height:1.4;&quot;&gt;&amp;#8226; Raises ValueError(&quot;quote mismatch&quot;)&lt;br/&gt;&amp;#8226; execution_status = FAILED (decision = null)&lt;br/&gt;&amp;#8226; Returns &lt;b&gt;502 runtime_execution_failure&lt;/b&gt;&lt;br/&gt;&amp;#8226; Blocks hallucinated citations from UI&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="620" width="290" height="130" as="geometry" />
        </mxCell>

        <!-- Outcome B: Verified Grounded Answer (HTTP 200) -->
        <mxCell id="s5_success" value="&lt;b style=&quot;font-size:13px;color:#166534;&quot;&gt;VERIFIED ANSWER (HTTP 200)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #86efac;margin:5px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#14532d;line-height:1.4;&quot;&gt;&amp;#8226; &lt;b&gt;Decision:&lt;/b&gt; ANSWER&lt;br/&gt;&amp;#8226; &lt;b&gt;Output:&lt;/b&gt; Grounded answer + verified citations&lt;br/&gt;&amp;#8226; &lt;b&gt;Ledger:&lt;/b&gt; Emits complete retrieval provenance&lt;br/&gt;&amp;#8226; Returns &lt;b&gt;200 QueryResponse&lt;/b&gt; to Query Lab&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="935" y="620" width="290" height="130" as="geometry" />
        </mxCell>
    

        <mxCell id="zone2_container" value="&lt;b style=&quot;font-size:13.5px;color:#78350f;&quot;&gt;DISTINCT BRANCH: BATCH EXPERIMENT &amp;amp; EVALUATION PIPELINE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#92400e;&quot;&gt;Triggered via /experiments UI or benchmark runner &amp;#8212; Decoupled from interactive query loop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1275" y="85" width="530" height="700" as="geometry" />
        </mxCell>

        <!-- E1: Experiment Jobs Queue -->
        <mxCell id="e1_queue" value="&lt;b style=&quot;font-size:13px;color:#78350f;&quot;&gt;1. Bounded Experiment Jobs Runner&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#92400e;&quot;&gt;app.evaluation.experiment_jobs &amp; POST /api/v1/experiments/jobs&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fde68a;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#451a03;line-height:1.45;&quot;&gt;&amp;#8226; Ingests &lt;b&gt;ExperimentRequest&lt;/b&gt; for synthetic cohort (p4_synthetic_v1)&lt;br/&gt;&amp;#8226; &lt;b&gt;Capacity Limit:&lt;/b&gt; Max 5 jobs (1 running, 4 queued in FIFO)&lt;br/&gt;&amp;#8226; Returns &lt;b&gt;HTTP 429 QueueFull&lt;/b&gt; if saturated&lt;br/&gt;&amp;#8226; Dispatches cohort questions through retrieval &amp;amp; policy pipeline&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.2;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1295" y="145" width="490" height="150" as="geometry" />
        </mxCell>

        <!-- E2: SQLite Persistence -->
        <mxCell id="e2_sqlite" value="&lt;b style=&quot;font-size:13px;color:#78350f;&quot;&gt;2. SQLite Durable Persistence&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#92400e;&quot;&gt;app.db.experiments::ExperimentStore &amp; /state/experiments.sqlite3&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fde68a;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#451a03;line-height:1.45;&quot;&gt;&amp;#8226; &lt;b&gt;Table jobs:&lt;/b&gt; Persists job parameters, questions, decisions, and scores&lt;br/&gt;&amp;#8226; &lt;b&gt;Table freezes:&lt;/b&gt; Saves immutable benchmark baselines (SHA256 locked)&lt;br/&gt;&amp;#8226; &lt;b&gt;Concurrency Lock:&lt;/b&gt; OS file locking prevents database corruption&lt;br/&gt;&amp;#8226; Fully persists across Docker container restarts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=1.2;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1295" y="335" width="490" height="150" as="geometry" />
        </mxCell>

        <!-- E3: Research Evaluation Engine -->
        <mxCell id="e3_metrics" value="&lt;b style=&quot;font-size:13px;color:#0e7490;&quot;&gt;3. Research Evaluation &amp;amp; Selective Classification&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#0e7490;&quot;&gt;app.evaluation.risk_coverage &amp; POST /api/v1/experiments/{id}/analysis&lt;/span&gt;&lt;hr style=&quot;border:0;border-top:1px solid #a5f3fc;margin:6px 0;&quot;/&gt;&lt;div style=&quot;text-align:left;font-size:11px;color:#164e63;line-height:1.45;&quot;&gt;&amp;#8226; &lt;b&gt;Empirical Coverage &amp;Phi;(&amp;tau;):&lt;/b&gt; Answered questions / Total questions (A/N)&lt;br/&gt;&amp;#8226; &lt;b&gt;Selective Risk R(&amp;tau;):&lt;/b&gt; Lexical-proxy risk on answered cohort&lt;br/&gt;&amp;#8226; &lt;b&gt;Right-Step AURC:&lt;/b&gt; Exact right-step integration across saved operating points&lt;br/&gt;&amp;#8226; &lt;b&gt;Uncertainty:&lt;/b&gt; Paired bootstrap confidence intervals (2,000 resamples)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#06b6d4;strokeWidth=1.2;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1295" y="525" width="490" height="150" as="geometry" />
        </mxCell>
    

        <mxCell id="zone3_container" value="&lt;b style=&quot;font-size:13.5px;color:#166534;&quot;&gt;RESEARCH ANALYSIS &amp;amp; VISUALIZATION DASHBOARD (frontend/components/evaluation-dashboard.tsx)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Visualizes batch experiment results across 5 verified chart components&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="35" y="805" width="1770" height="270" as="geometry" />
        </mxCell>

        <!-- Chart 1: Risk-Coverage -->
        <mxCell id="chart_rc" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;1. Risk&amp;#8211;Coverage Curve&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10.5px;color:#334155;text-align:left;line-height:1.35;&quot;&gt;&amp;#8226; Coverage &amp;Phi; on X-axis [0, 1]&lt;br/&gt;&amp;#8226; Selective Risk R on Y-axis [0, 1]&lt;br/&gt;&amp;#8226; Full or partial right-step AURC&lt;br/&gt;&amp;#8226; Plots saved operating points&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="55" y="845" width="320" height="210" as="geometry" />
        </mxCell>

        <!-- Chart 2: Policy Comparison -->
        <mxCell id="chart_policy" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;2. Policy Performance&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10.5px;color:#334155;text-align:left;line-height:1.35;&quot;&gt;&amp;#8226; Compares 3 policies side-by-side&lt;br/&gt;&amp;#8226; Always Answer vs Threshold vs Prompt&lt;br/&gt;&amp;#8226; Metrics: Coverage A/N, Risk, Failure Rate&lt;br/&gt;&amp;#8226; Bootstrap confidence intervals&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="405" y="845" width="320" height="210" as="geometry" />
        </mxCell>

        <!-- Chart 3: Confidence Calibration -->
        <mxCell id="chart_calib" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;3. Confidence Calibration&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-size:10.5px;color:#334155;text-align:left;line-height:1.35;&quot;&gt;&amp;#8226; Reliability diagram across 10 bins&lt;br/&gt;&amp;#8226; Model confidence vs observed accuracy&lt;br/&gt;&amp;#8226; Diagonal perfect calibration line&lt;br/&gt;&amp;#8226; Uncalibrated scores are not probabilities&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="755" y="845" width="320" height="210" as="geometry" />
        </mxCell>

        <!-- Chart 4: Retrieval Performance -->
