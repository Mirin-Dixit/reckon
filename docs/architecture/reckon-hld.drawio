        <mxCell id="host_boundary" value="&lt;b style=&quot;font-size:13px;color:#475569;&quot;&gt;HOST ENVIRONMENT (Developer Laptop)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;verticalAlign=top;align=center;spacingTop=10;fontFamily=Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="35" y="85" width="220" height="870" as="geometry" />
